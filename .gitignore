# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files
!override.tf
!override.tf.json
!*_override.tf
!*_override.tf.json

# Exclude secret variables
# *.tfvars files are allowed if they don't contain secrets.
# Use .env or specific secret files for sensitive data.
# *.tfvars
# *.tfvars.json

# Ignore tfplan
tfplan
**/tfplan

# OS files
.DS_Store
Thumbs.db
