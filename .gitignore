# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files
!override.tf
!override.tf.json
!*_override.tf
!*_override.tf.json

# Exclude terraform.tfvars and secret variables
# (Keeping variables.tf but ignoring actual secrets in .tfvars)
*.tfvars
*.tfvars.json

# Ignore tfplan
tfplan
**/tfplan

# OS files
.DS_Store
Thumbs.db
